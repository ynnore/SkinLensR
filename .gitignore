# ================================================
# Fichier .gitignore pour le projet SkinLensR
# ================================================

# ------------------------------------------------
# Fichiers d'environnement/secret
# ------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
key.json
credentials.json
service_account.json

# ------------------------------------------------
# Fichiers et répertoires Python
# ------------------------------------------------

# Environnements virtuels
venv/
.venv/
env/
venv312/
../venv312/

# Cache de compilation Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Fichiers générés par setuptools
*.egg-info/
*.egg
*.whl
.installed.cfg
build/
dist/

# Fichiers de log Python
*.log

# Caches pip
.pip/
pip-wheel-metadata/
pip/

# Bases de données locales pour le développement
*.db
*.sqlite3
backend/chroma_db/

# Fichiers de configuration spécifiques
config.local.yaml

# Fichiers de test / génération de données
fixtures/
generated_data/

# Fichiers de sauvegarde d'IDE ou d'éditeur
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------
# Fichiers système
# ------------------------------------------------
.DS_Store
Thumbs.db

# ------------------------------------------------
# Fichiers Node.js / Next.js (pour le frontend)
# ------------------------------------------------
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------
# Fichiers spécifiques au projet à ignorer
# ------------------------------------------------
kiwi_ops.db
uvicorn
*.blend1
*.blend2
Screenshot Try.png
screenshot.png
model.h5
model.json