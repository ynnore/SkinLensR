import i18n from 'i18next';
import { initReactI18next } from 'react-i18next';
import HttpBackend from 'i18next-http-backend'; // Pour charger les traductions depuis le dossier public

i18n
  .use(HttpBackend) // Utilise le backend HTTP pour charger les fichiers JSON
  .use(initReactI18next)
  .init({
    lng: 'fr', // Langue par défaut
    fallbackLng: 'fr', // Langue de secours
    backend: {
      loadPath: '/locales/{{lng}}/translation.json', // Le chemin vers le fichier de traduction
    },
    interpolation: {
      escapeValue: false, // React échappe déjà les valeurs
    },
  });

export default i18n;